rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.email is string &&
             data.email.size() <= 256 &&
             data.role in ['admin', 'auditor', 'viewer'] &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120));
    }

    function isValidChannel(data) {
      return data.id is string && isValidId(data.id) &&
             data.ownerId == request.auth.uid &&
             data.title is string && data.title.size() <= 200 &&
             data.platform in ['whatnot', 'tiktok', 'twitch', 'youtube', 'custom'] &&
             data.totalViews is number && data.totalViews >= 0 &&
             data.authenticatedViewers is number && data.authenticatedViewers >= 0 &&
             data.hypeScore is number && data.hypeScore >= 0.0 && data.hypeScore <= 1.0 &&
             data.status in ['normal', 'flagged', 'critical', 'investigating'];
    }

    function isValidCampaign(data) {
      return data.id is string && isValidId(data.id) &&
             data.ownerId == request.auth.uid &&
             data.campaignName is string && data.campaignName.size() <= 200 &&
             data.category in ['dm_followup', 'chat_icebreaker', 'vip_newsletter', 'social_hook'] &&
             data.generatedCopy is string && data.generatedCopy.size() <= 5000;
    }

    // Match User Profiles
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId;
      allow delete: if isOwner(userId);

      // User Channels Subcollection
      match /channels/{channelId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(channelId) && isValidChannel(incoming());
        allow update: if isOwner(userId) && isValidId(channelId) && isValidChannel(incoming()) &&
                         incoming().ownerId == existing().ownerId;
        allow delete: if isOwner(userId) && isValidId(channelId);
      }

      // User Saved Marketing Campaigns Subcollection
      match /campaigns/{campaignId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(campaignId) && isValidCampaign(incoming());
        allow update: if isOwner(userId) && isValidId(campaignId) && isValidCampaign(incoming()) &&
                         incoming().ownerId == existing().ownerId;
        allow delete: if isOwner(userId) && isValidId(campaignId);
      }
    }
  }
}
